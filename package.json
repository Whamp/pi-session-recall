{
  "name": "pi-session-recall",
  "version": "0.1.0",
  "private": true,
  "description": "Pi extension that indexes conversation history in one SQLite Recall database.",
  "keywords": [
    "conversation-memory",
    "pi-package",
    "sqlite"
  ],
  "bin": {
    "psr": "./bin/psr"
  },
  "type": "module",
  "scripts": {
    "test": "node --import tsx --test src/**/*.test.ts",
    "evaluate:recall": "node --import tsx src/evaluate-recall-quality.ts",
    "replay:session-import": "node --import tsx src/replaySessionImportCorpus.ts",
    "certify:unified-sqlite-recall": "node --import tsx src/certify-unified-sqlite-recall-production.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware src",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.1.3",
    "@zvec/zvec": "0.6.0",
    "sqlite-vec": "0.1.9",
    "tsx": "4.23.1",
    "typebox": "1.3.8"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@types/node": "^24.0.0",
    "oxfmt": "^0.27.0",
    "oxlint": "^1.48.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./src/recall-extension.ts"
    ]
  }
}
