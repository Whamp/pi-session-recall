{
  "name": "pi-session-recall",
  "version": "0.1.0",
  "private": true,
  "description": "Pi extension that indexes conversation history in zvec and recalls past session details.",
  "keywords": [
    "conversation-memory",
    "pi-package",
    "zvec"
  ],
  "type": "module",
  "scripts": {
    "test": "node --import tsx --test src/**/*.test.ts",
    "evaluate:recall": "node --import tsx src/evaluate-recall-quality.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware src",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.82.0",
    "@huggingface/tokenizers": "0.1.3",
    "@zvec/zvec": "0.6.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@types/node": "^24.0.0",
    "oxfmt": "^0.27.0",
    "oxlint": "^1.48.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "^4.20.0",
    "typebox": "^1.0.55",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./src/recall-extension.ts"
    ]
  }
}
